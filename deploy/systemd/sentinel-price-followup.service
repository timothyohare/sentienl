[Unit]
Description=Sentinel — Price Follow-Through Backfill
After=network-online.target
Wants=network-online.target
PartOf=sentinel.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/dev/newdev/Sentinel
Environment=SENTINEL_DB=%h/dev/newdev/Sentinel/sentinel.db
ExecStart=%h/dev/newdev/Sentinel/venv/bin/python %h/dev/newdev/Sentinel/sentinel/scripts/price_followup.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sentinel.target
