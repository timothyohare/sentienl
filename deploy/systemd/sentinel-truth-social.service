[Unit]
Description=Sentinel — Truth Social Collector (Playwright)
After=network-online.target
Wants=network-online.target
PartOf=sentinel.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/dev/newdev/Sentinel
Environment=SENTINEL_CONFIG=%h/dev/newdev/Sentinel/config.yaml
Environment=SENTINEL_DB=%h/dev/newdev/Sentinel/sentinel.db
Environment=SENTINEL_ENV=%h/dev/newdev/Sentinel/.env
ExecStart=%h/dev/newdev/Sentinel/venv/bin/python -m sentinel.collectors.truth_social_runner
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sentinel.target
